# ─────────────────────────────────────────────────
# KutumbKosh Mobile — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Only EXPO_PUBLIC_* vars are exposed to the client.

# Sentry DSN for crash and error reporting
# Get yours at https://sentry.io/settings/projects/
EXPO_PUBLIC_SENTRY_DSN=https://example@sentry.io/123456

# ─────────────────────────────────────────────────
# Optional: Auth & server defaults
# ─────────────────────────────────────────────────
# EXPO_PUBLIC_API_URL=http://localhost:3000
